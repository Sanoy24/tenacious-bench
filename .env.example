# ─────────────────────────────────────────────────────────────
# Tenacious-Bench Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# OpenRouter API key — required for multi-LLM synthesis generation.
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ── Model Selection ──────────────────────────────────────────
# Dev-tier model used for task generation (cheap, high volume).
GENERATOR_MODEL=deepseek/deepseek-chat-v3-0324

# Judge model used for quality filtering (different family to avoid bias).
JUDGE_MODEL=google/gemini-2.0-flash-001

# ── Generation Tuning ────────────────────────────────────────
# Number of tasks the multi-LLM synthesis pipeline targets.
SYNTHESIS_TARGET_TASKS=63

# Max tasks per single API call batch.
SYNTHESIS_BATCH_SIZE=7

# ── Contamination Check ──────────────────────────────────────
# Embedding model used for semantic similarity checks.
# Runs locally via sentence-transformers — no API cost.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# N-gram overlap threshold (tasks sharing >=N grams are flagged).
NGRAM_THRESHOLD=8

# Cosine similarity threshold (pairs above this are flagged).
COSINE_THRESHOLD=0.85

# ── Reproducibility ──────────────────────────────────────────
# Global random seed for all generators.
RANDOM_SEED=42
